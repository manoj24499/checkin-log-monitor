# Read-only Postgres role (see scripts/create-readonly-role.sql). Never use the app's own DATABASE_URL.
MONITOR_DATABASE_URL=postgresql://monitor_ro:CHANGE_ME@HOST:5432/postgres
# Single admin password for the monitor login (required)
MONITOR_PASSWORD=change-me-to-a-long-passphrase
# At least 32 random characters, used to sign the session cookie (required)
MONITOR_SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Port: `npm start` listens on 3100 (see package.json: next start -p 3100)
